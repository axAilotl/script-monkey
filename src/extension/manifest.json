{
  "manifest_version": 3,
  "name": "Script Monkey",
  "version": "0.1.0",
  "description": "Build and maintain ordinary userscripts with your local Codex CLI and existing userscript manager.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Script Monkey"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
